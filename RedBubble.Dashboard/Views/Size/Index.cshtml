@model IEnumerable<RedBubble.Application.DTOs.SizeDto>

@{
    ViewData["Title"] = "Sizes";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a class="btn btn-primary btn-sm shadow-sm" asp-action="Create">
        <i class="fas fa-plus fa-sm text-white-50"></i> Create New Size
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Size List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>#</th> 
                        <th>Size Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int serialNumber = 1;
                    }
                    @foreach (var size in Model.OrderBy(s => s.Id)) 
                    {
                        <tr>
                            <td>@(serialNumber++)</td>
                            <td>@size.SizeName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(size.Description))
                                {
                                    @size.Description
                                }
                                else
                                {
                                    <em class="text-muted">No description</em>
                                }
                            </td>
                            <td>
                                @if (size.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">

                                    <a asp-action="Edit" asp-route-id="@size.Id" class="btn btn-warning btn-sm ms-2">Edit</a>


                                    <form asp-action="Delete" asp-route-id="@size.Id" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this size?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No sizes found. <a asp-action="Create">Create your first size</a>.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#sizeTable').DataTable({
                "paging": false,
                "info": false,
                "ordering": false,         
                "searching": false,       
                "columnDefs": [
                    { "className": "text-center", "targets": [0, 4] }
                ],
                "dom": "t<'row mt-3'<'col-md-7'l><'col-md-5'p>>",
                "language": {
                    "lengthMenu": "عرض _MENU_ عنصر لكل صفحة"
                }
            });
        });
    </script>
}