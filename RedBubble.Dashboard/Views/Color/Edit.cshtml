@model RedBubble.Application.DTOs.UpdateColorDto

@{
    ViewData["Title"] = "Edit Color";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Color</h1>
    <div>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Colors
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Color Information</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                
                <div class="col-md-6 mb-3">
                    <label asp-for="ColorName" class="form-label">Color Name</label>
                    <input asp-for="ColorName" class="form-control" placeholder="e.g., Forest Green" />
                    <span asp-validation-for="ColorName" class="text-danger"></span>
                </div>

               
                <div class="col-md-6 mb-3">
                    <label class="form-label">Color Code</label>
                    <div class="input-group">
                        
                        <input type="color"
                               id="colorPicker"
                               class="form-control form-control-color"
                               style="height: 45px; width: 60px; cursor: pointer;"
                               title="Pick a color" />

                     
                        <input asp-for="ColorCode"
                               id="ColorCode"
                               class="form-control"
                               placeholder="#FF5733"
                               maxlength="7" />
                    </div>
                    <small class="form-text text-muted">Enter hex color code (e.g., #FF5733)</small>
                    <span asp-validation-for="ColorCode" class="text-danger"></span>
                </div>
            </div>

          
            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update Color
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            const $colorPicker = $('#colorPicker');
            const $colorCodeInput = $('#ColorCode');

            
            function formatColor(value) {
                if (!value) return '#000000';
                if (!value.startsWith('#')) value = '#' + value;
                if (value.length > 7) value = value.substring(0, 7);
                return value.toUpperCase();
            }

            
            $colorPicker.on('change', function () {
                let color = $(this).val();
                $colorCodeInput.val(color);
                updatePreview(color);
            });

            
            $colorCodeInput.on('input', function () {
                let value = $(this).val();
                
                if (/^#[0-9A-F]{0,6}$/i.test(value) || /^[0-9A-F]{0,6}$/i.test(value)) {
                    if (value.length === 7 || (value.length === 6 && /^[0-9A-F]{6}$/i.test(value))) {
                        let formatted = formatColor(value);
                        $colorPicker.val(formatted);
                        updatePreview(formatted);
                    } else if (value.length < 7) {
                        
                        updatePreview(value);
                    }
                }
            });

          
            function initializeColor() {
                let currentColor = $colorCodeInput.val() || '#000000';
                currentColor = formatColor(currentColor);
                $colorCodeInput.val(currentColor);
                $colorPicker.val(currentColor);
                updatePreview(currentColor);
            }

           
            function updatePreview(color) {
                
            }

            
            initializeColor();
        });
    </script>
}