@model IEnumerable<RedBubble.Application.DTOs.Products.BaseProductListDto>

@{
    ViewData["Title"] = "Base Products";
    var search = ViewData["CurrentFilter"]?.ToString();
    var productType = ViewData["CurrentProductType"]?.ToString();
    var hasSize = (bool?)ViewData["CurrentHasSize"];
    var hasColors = (bool?)ViewData["CurrentHasColors"];
    var isActive = (bool?)ViewData["CurrentIsActive"];
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a class="btn btn-primary btn-sm shadow-sm" asp-action="Create">
        <i class="fas fa-plus fa-sm text-white-50"></i> Create New Base Product
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Advanced Filters -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-filter"></i> Filters & Search
        </h6>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label for="search" class="form-label">Search</label>
                        <input name="search" class="form-control" value="@search" placeholder="Name, description, category..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label for="productType" class="form-label">Product Type</label>
                        <input name="productType" class="form-control" value="@productType" placeholder="T-Shirt, Mug, Poster..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group mb-3">
                        <label for="hasSize" class="form-label">Has Sizes</label>
                        <select name="hasSize" class="form-control">
                            <option value="">All</option>
                            <option value="true" selected="@(hasSize == true)">Yes</option>
                            <option value="false" selected="@(hasSize == false)">No</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group mb-3">
                        <label for="hasColors" class="form-label">Has Colors</label>
                        <select name="hasColors" class="form-control">
                            <option value="">All</option>
                            <option value="true" selected="@(hasColors == true)">Yes</option>
                            <option value="false" selected="@(hasColors == false)">No</option>
                        </select>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Clear Filters
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Products List -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            Base Products (@Model.Count() found)
        </h6>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="row">
                @foreach (var product in Model.OrderBy(p => p.Id))
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card h-100 @(product.IsActive ? "border-left-primary" : "border-left-secondary")">
                            <!-- Product Image -->
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                @if (!string.IsNullOrEmpty(product.PrimaryMockupUrl))
                                {
                                    <img src="@product.PrimaryMockupUrl" alt="@product.Name"
                                         class="img-fluid rounded" style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="fas fa-image fa-3x mb-2"></i>
                                        <p>No Image</p>
                                    </div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column">
                                <div class="flex-grow-1">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="text-muted small">
                                        <span class="badge badge-info">@product.CategoryName</span>
                                        @if (!string.IsNullOrEmpty(product.CategoryName))
                                        {
                                            <span class="badge badge-secondary">@product.CategoryName</span>
                                        }
                                    </p>
                                    <p class="card-text">
                                        <strong>Base Price:</strong> @product.BasePrice.ToString("C")<br>
                                        <small class="text-muted">Created: @product.CreatedOn.ToString("MMM d, yyyy")</small>
                                    </p>
                                </div>

                                <!-- Product Capabilities -->
                                <div class="mb-3">
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <small class="text-muted d-block">Sizes</small>
                                            <span class="badge @(product.HasSizes ? "badge-success" : "badge-light")">
                                                <i class="fas @(product.HasSizes ? "fa-check" : "fa-times")"></i>
                                            </span>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted d-block">Colors</small>
                                            <span class="badge @(product.HasColors ? "badge-success" : "badge-light")">
                                                <i class="fas @(product.HasColors ? "fa-check" : "fa-times")"></i>
                                            </span>
                                        </div>
                                        <div class="col-4">
                                            <small class="text-muted d-block">Status</small>
                                            <span class="badge @(product.IsActive ? "badge-success" : "badge-secondary")">
                                                @(product.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="btn-group-vertical" role="group">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-info btn-sm mb-1">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm mb-1">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="Variants" asp-route-id="@product.Id" class="btn btn-primary btn-sm mb-1">
                                        <i class="fas fa-list"></i> Variants
                                    </a>
                                </div>

                                <!-- Delete Button (separate for danger styling) -->
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="mt-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm btn-block"
                                            onclick="return confirm('Are you sure you want to delete @product.Name?');">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Info -->
            <div class="row mt-3">
                <div class="col-12">
                    <small class="text-muted">
                        Showing @Model.Count() products
                        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(productType) || hasSize.HasValue || hasColors.HasValue || isActive.HasValue)
                        {
                            <text> (filtered)</text>
                        }
                    </small>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No Base Products Found</h5>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(productType) || hasSize.HasValue || hasColors.HasValue || isActive.HasValue)
                    {
                        <text>No products match your current filters. <a asp-action="Index">Clear filters</a> to see all products.</text>
                    }
                    else
                    {
                        <text>Get started by creating your first base product.</text>
                    }
                </p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Create Your First Base Product
                </a>
            </div>
        }
    </div>
</div>

<!-- Quick Stats -->
@if (Model.Any())
{
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Products
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-box fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Products
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.IsActive)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                With Sizes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.HasSizes)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ruler fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                With Colors
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(p => p.HasColors)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-palette fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-clear success messages after 5 seconds
            setTimeout(function () {
                $('.alert-success').fadeOut();
            }, 5000);

            // Auto-clear error messages after 10 seconds
            setTimeout(function () {
                $('.alert-danger').fadeOut();
            }, 10000);
        });
    </script>
}