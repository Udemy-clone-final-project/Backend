@model IEnumerable<RedBubble.Application.DTOs.Products.ProductListDto>

@{
    ViewData["Title"] = "Base Products";
    var search = ViewData["CurrentFilter"]?.ToString();
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a class="btn btn-primary btn-sm shadow-sm" asp-action="Create">
        <i class="fas fa-plus fa-sm text-white-50"></i> Create New Base Product
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Search</h6>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="search" class="form-label">Search</label>
                        <input name="search" class="form-control" value="@search" placeholder="Search by name, description, or category" />
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-group mb-3">
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a asp-action="Index" class="btn btn-secondary">Clear</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Base Product List</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Base Price</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int serialNumber = 1;
                    }
                    @foreach (var product in Model.OrderBy(p => p.Id))
                    {
                        <tr>
                            <td>@(serialNumber++)</td>
                            <td>@product.Name</td>
                            <td>@product.BasePrice.ToString("C")</td>
                            <td>@product.CategoryName</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-info btn-sm ms-2">Details</a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm ms-2">Edit</a>
                                    <a asp-action="Variants" asp-route-id="@product.Id" class="btn btn-primary btn-sm ms-2">View Variants</a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline ms-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this base product?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No base products found. <a asp-action="Create">Create your first base product</a>.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "paging": false,
                "info": false,
                "ordering": false,
                "searching": false,
                "columnDefs": [
                    { "className": "text-center", "targets": [0, 4] }
                ],
                "dom": "t<'row mt-3'<'col-md-7'l><'col-md-5'p>>",
                "language": {
                    "lengthMenu": "Display _MENU_ items per page"
                }
            });
        });
    </script>
}