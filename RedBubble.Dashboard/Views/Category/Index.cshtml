@model IEnumerable<RedBubble.Application.DTOs.Products.CategoryWithSubCategoriesDto>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Categories Management</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Add New Category
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}



<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Categories List</h6>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered" id="categoryTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Subcategories</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int serial = 1;
                        }
                        @foreach (var category in Model.OrderBy(c => c.Id))
                        {
                            <tr>
                                <td>@(serial++)</td>
                                <td>
                                    <strong>@category.CategoryName</strong>
                                    @if (category.IsMainCategory)
                                    {
                                        <span class="badge bg-primary">Main</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(category.Description))
                                    {
                                        @category.Description
                                    }
                                    else
                                    {
                                        <em class="text-muted">No description</em>
                                    }
                                </td>
                                <td>
                                    @if (category.SubCategoriesCount > 0)
                                    {
                                        <span class="badge bg-info">@category.SubCategoriesCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-info btn-sm ms-2">Details</a>
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning btn-sm ms-2">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger btn-sm ms-2">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No categories found</h5>
                <p class="text-muted">Start by adding your first category.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add First Category
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#categoryTable').DataTable({
                "paging": false,
                "info": false,
                "ordering": false,
                "searching": true,
                "columnDefs": [
                    { "className": "text-center", "targets": [0, 3, 4] }
                ]
            });
        });
    </script>
}