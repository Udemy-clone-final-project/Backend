@model RedBubble.Application.DTOs.Design.CreateDesignDto

@{
    ViewData["Title"] = "Create New Design";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Create New Design</h1>
    <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
    </a>
</div>

@* Display messages *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle"></i> @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-palette"></i> Design Information
        </h6>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="designForm">
            <input asp-for="AdminId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Basic Information -->
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">
                        Design Title <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., Mountain Sunset" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">
                        Design Price <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" placeholder="5.00" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger"></span>
                    <div class="form-text">This will be added to the base product price</div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">
                    Description <span class="text-danger">*</span>
                </label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your design in detail..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <div class="char-counter form-text text-end"></div>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label">
                        Make this design available for purchase immediately
                    </label>
                </div>
            </div>

            <!-- Image Upload Section -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-image text-primary"></i> Design Image
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="ImageFile" class="form-label">
                                Upload Design Image <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" required />
                            <div class="form-text">
                                <strong>Requirements:</strong> JPEG, PNG, GIF, or WebP format. Maximum size: 5MB.
                                Recommended: At least 300 DPI for best print quality.
                            </div>
                            <span class="text-danger" id="image-error"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="AltText" class="form-label">Alt Text (Optional)</label>
                            <input asp-for="AltText" class="form-control" placeholder="Describe the image..." maxlength="255" />
                            <span asp-validation-for="AltText" class="text-danger"></span>
                            <div class="form-text">Helps with accessibility and SEO</div>
                        </div>
                    </div>

                    <!-- Image Preview -->
                    <div id="image-preview" class="mt-3" style="display: none;">
                        <label class="form-label">Preview:</label>
                        <div class="border rounded p-3 bg-light" style="max-width: 400px;">
                            <img id="preview-img" src="" alt="Preview" class="img-fluid rounded" style="max-height: 250px;" />
                            <div class="mt-2">
                                <small id="file-info" class="text-muted d-block"></small>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="remove-image">
                                    <i class="fas fa-trash"></i> Remove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Base Products Selection -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-box text-primary"></i> Select Products
                    </h6>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label>Choose Base Products for Variant Generation</label>
                        <select asp-for="BaseProductIds" asp-items="ViewBag.BaseProducts" multiple class="form-control" id="baseProductSelect" size="6">
                        </select>
                        <div class="form-text">
                            Hold CTRL (Windows) or CMD (Mac) to select multiple products.
                            Variants will be automatically generated for all selected products.
                        </div>
                    </div>

                    @* <!-- Compatibility Check Button -->
                    <button type="button" class="btn btn-info" id="checkCompatibilityBtn" disabled>
                        <i class="fas fa-search"></i> Check Compatibility
                    </button> *@

                    <!-- Compatibility Results -->
                    <div id="compatibility-results" class="mt-3" style="display: none;">
                        <div class="alert alert-info">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-spinner fa-spin"></i> Checking compatibility...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Variant Preview Section -->
            <div class="card mb-4" id="preview-section" style="display: none;">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-eye text-primary"></i> Variant Preview
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Preview how your design will look on selected products...</p>
                    <div id="variant-previews" class="row">
                        <!-- Previews will be loaded here -->
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                        <i class="fas fa-save"></i> Create Design & Generate Variants
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg ms-2">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
                <div class="text-muted">
                    <small><span class="text-danger">*</span> Required fields</small>
                </div>
            </div>

            <!-- Generation Progress -->
            <div id="generation-progress" class="mt-4" style="display: none;">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <h5>Generating Variants...</h5>
                        <p class="text-muted mb-0">
                            Creating product variants with smart scaling. This may take a few moments.
                        </p>
                        <div class="progress mt-3">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Elements
            const imageFileInput = $('#ImageFile');
            const baseProductSelect = $('#baseProductSelect');
            const checkCompatibilityBtn = $('#checkCompatibilityBtn');
            const compatibilityResults = $('#compatibility-results');
            const previewSection = $('#preview-section');
            const variantPreviews = $('#variant-previews');
            const submitBtn = $('#submitBtn');
            const generationProgress = $('#generation-progress');
            const form = $('#designForm');

            // File validation
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
            const maxSize = 5 * 1024 * 1024; // 5MB

            // Image preview functionality
            imageFileInput.on('change', function (e) {
                const file = e.target.files[0];
                handleImagePreview(file);
                updateCompatibilityButton();
            });

            // Base product selection change
            baseProductSelect.on('change', function() {
                updateCompatibilityButton();
                compatibilityResults.hide();
                previewSection.hide();
            });

            // Compatibility check
            checkCompatibilityBtn.on('click', function() {
                checkCompatibility();
            });

            // Form submission
            form.on('submit', function (e) {
                if (!validateForm()) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                submitBtn.prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin"></i> Creating...');
                generationProgress.show();

                // Simulate progress
                simulateProgress();
            });

            // Character counter for description
            $('#Description').on('input', function () {
                const current = $(this).val().length;
                const max = 1000;
                $('.char-counter').text(`${current}/${max} characters`)
                    .toggleClass('text-danger', current > max);
            });

            // Auto-generate alt text
            $('#Title').on('blur', function () {
                const title = $(this).val();
                const altText = $('#AltText');
                if (title && !altText.val()) {
                    altText.val(`Design: ${title}`);
                }
            });

            // Remove image
            $('#remove-image').on('click', function () {
                imageFileInput.val('');
                $('#image-preview').hide();
                $('#image-error').text('');
                updateCompatibilityButton();
            });

            // Functions
            function handleImagePreview(file) {
                const errorElement = $('#image-error');
                const previewElement = $('#image-preview');

                errorElement.text('');
                previewElement.hide();

                if (!file) return;

                // Validate file
                if (!allowedTypes.includes(file.type)) {
                    errorElement.text('Please select a valid image file (JPEG, PNG, GIF, or WebP).');
                    imageFileInput.val('');
                    return;
                }

                if (file.size > maxSize) {
                    errorElement.text('File size must be less than 5MB.');
                    imageFileInput.val('');
                    return;
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#preview-img').attr('src', e.target.result);
                    $('#file-info').html(`
                        <strong>File:</strong> ${file.name}<br>
                        <strong>Size:</strong> ${(file.size / 1024 / 1024).toFixed(2)} MB<br>
                        <strong>Dimensions:</strong> Loading...
                    `);
                    previewElement.show();

                    // Get image dimensions
                    const img = new Image();
                    img.onload = function() {
                        $('#file-info').html(`
                            <strong>File:</strong> ${file.name}<br>
                            <strong>Size:</strong> ${(file.size / 1024 / 1024).toFixed(2)} MB<br>
                            <strong>Dimensions:</strong> ${this.width} × ${this.height}px
                        `);
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }

            function updateCompatibilityButton() {
                const hasImage = imageFileInput.val() !== '';
                const hasProducts = baseProductSelect.val() && baseProductSelect.val().length > 0;
                checkCompatibilityBtn.prop('disabled', !hasImage || !hasProducts);
            }

            function checkCompatibility() {
                const imageFile = imageFileInput[0].files[0];
                const selectedProducts = baseProductSelect.val() || [];

                if (!imageFile || selectedProducts.length === 0) return;

                // Show loading
                compatibilityResults.html(`
                    <div class="alert alert-info">
                        <i class="fas fa-spinner fa-spin"></i> Analyzing design compatibility...
                    </div>
                `).show();

                // Create form data
                const formData = new FormData();
                formData.append('imageFile', imageFile);
                selectedProducts.forEach(id => formData.append('baseProductIds', id));

                // Make AJAX call
                $.ajax({
                    url: '@Url.Action("CheckCompatibility", "Design")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        if (response.success) {
                            displayCompatibilityResults(response);
                        } else {
                            showCompatibilityError(response.error);
                        }
                    },
                    error: function() {
                        showCompatibilityError('Failed to check compatibility. Please try again.');
                    }
                });
            }

            function displayCompatibilityResults(data) {
                let html = '';

                if (data.overallCompatible) {
                    html += `<div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> <strong>Great!</strong> ${data.summary}
                    </div>`;
                } else {
                    html += `<div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Warning:</strong> ${data.summary}
                    </div>`;
                }

                // Show detailed results
                html += '<div class="mt-3"><h6>Detailed Results:</h6>';
                data.results.forEach(result => {
                    const alertClass = result.isCompatible ? 'alert-success' : 'alert-danger';
                    const icon = result.isCompatible ? 'check-circle' : 'exclamation-circle';

                    html += `
                        <div class="alert ${alertClass} alert-sm mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <i class="fas fa-${icon}"></i>
                                    <strong>${result.baseProductName}</strong>
                                    ${result.message ? `<br><small>${result.message}</small>` : ''}
                                </div>
                            </div>
                    `;

                    if (result.printAreas && result.printAreas.length > 0) {
                        html += '<div class="mt-2"><small>';
                        result.printAreas.forEach(pa => {
                            const scalePercent = (pa.scaleFactor * 100).toFixed(0);
                            html += `<div><strong>${pa.printAreaName}:</strong> ${scalePercent}% scale`;
                            if (pa.warning) html += ` <em class="text-warning">(${pa.warning})</em>`;
                            html += '</div>';
                        });
                        html += '</small></div>';
                    }

                    html += '</div>';
                });
                html += '</div>';

                compatibilityResults.html(html);
            }

            function showCompatibilityError(message) {
                compatibilityResults.html(`
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i> ${message}
                    </div>
                `);
            }

            function validateForm() {
                if (!imageFileInput.val()) {
                    $('#image-error').text('Please select an image file.');
                    imageFileInput.focus();
                    return false;
                }

                const selectedProducts = baseProductSelect.val() || [];
                if (selectedProducts.length === 0) {
                    alert('Please select at least one base product to generate variants.');
                    baseProductSelect.focus();
                    return false;
                }

                return true;
            }

            function simulateProgress() {
                let progress = 0;
                const interval = setInterval(() => {
                    progress += Math.random() * 15;
                    if (progress > 90) progress = 90;
                    $('.progress-bar').css('width', progress + '%');
                }, 500);

                // Clear after 30 seconds (fallback)
                setTimeout(() => clearInterval(interval), 30000);
            }
        });
    </script>

    <style>
        .alert-sm {
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
        }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
        }

        .progress {
            height: 8px;
        }

        .form-label {
            font-weight: 600;
        }

        #image-preview img {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .btn:disabled {
            cursor: not-allowed;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
    </style>
}